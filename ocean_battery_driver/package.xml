  <version>2.0.0</version>
  <description>This is an interface to the Ocean Server Technology Intelligent Battery and Power System.</description>
  <maintainer email="ros-orphaned-packages@googlegroups.com">ROS Orphaned Package Maintainers</maintainer>

  <license>BSD</license>

  <url type="website">http://www.ros.org/wiki/ocean_battery_driver</url>
  <url type="repository">https://github.com/pr2-config-iai/pr2_power_drivers</url>

  <author>Tully Foote</author>
